---
import Layout from "../layouts/Layout.astro";
---

<Layout>
	<main class="landing landing-type">
		<section class="intro" aria-labelledby="intro-title">
			<h1 id="intro-title"><span class="headline-text">Hi, I'm <span class="accent">f1047</span></span><span class="bee">🐝</span></h1>
		</section>
	</main>
</Layout>

<style>
	.landing-type {
		font-family: var(--font-sans);
		font-optical-sizing: auto;
		font-weight: var(--font-weight-strong);
		font-style: normal;
	}

	.landing {
		position: relative;
		display: grid;
		min-height: var(--site-content-min-height);
		place-items: center;
		overflow: hidden;
		background: var(--color-glass-page);
		-webkit-backdrop-filter: blur(var(--site-content-blur));
		backdrop-filter: blur(var(--site-content-blur));
		color: var(--color-text);
	}

	.intro {
		width: min(100% - 40px, 960px);
		padding: 56px 0;
		text-align: center;
	}

	h1 {
		display: inline-flex;
		align-items: baseline;
		justify-content: center;
		margin: 0;
		font-size: 5rem;
		font-weight: var(--font-weight-strong);
		letter-spacing: 0;
		line-height: 1.04;
		text-wrap: balance;
		text-shadow: 0 2px 28px rgba(255, 255, 255, 0.68);
	}

	:global(.headline-text) {
		line-height: inherit;
	}

	:global(.accent) {
		color: var(--color-accent);
	}

	:global(.bee) {
		display: inline-block;
		line-height: 1;
	}

	@media (max-width: 720px) {
		.intro {
			width: min(100% - 32px, 560px);
			padding: 40px 0;
		}

		h1 {
			font-size: 3.2rem;
			line-height: 1.08;
		}
	}
</style>
